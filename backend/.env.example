# ── Required (server refuses to start without these) ──
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=use-a-long-random-string-of-32-or-more-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-unique-password

# ── Image uploads (Cloudinary) ──
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# ── Payments (optional; online payment is disabled if missing) ──
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
CURRENCY=INR

# ── Server ──
PORT=4000
# Comma-separated browser origins allowed to call the API.
# Leave unset to use the built-in defaults (the two Vercel apps + localhost).
# CORS_ORIGINS=https://my-patient-app.com,https://my-admin-app.com
# Keep-alive ping target (Render sets RENDER_EXTERNAL_URL automatically)
# KEEP_ALIVE_URL=https://your-api.onrender.com/
